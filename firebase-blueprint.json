{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile with role and private contact details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["tourist", "guide", "hotel_owner", "vehicle_owner", "admin"] },
        "avatarUrl": { "type": "string", "maxLength": 120000 },
        "city": { "type": "string", "maxLength": 80 },
        "isSuspended": { "type": "boolean" },
        "savedDestinationIds": { "type": "array" },
        "savedGuideIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "role", "isSuspended", "createdAt", "updatedAt"]
    },
    "Destination": {
      "title": "Destination",
      "description": "Curated Pakistani tourism destination metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "region": { "type": "string", "enum": ["Gilgit-Baltistan", "Swat & Kaghan", "High Passes", "Lakes & Meadows"] },
        "province": { "type": "string", "maxLength": 80 },
        "tagline": { "type": "string", "maxLength": 180 },
        "description": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "bestTimeToVisit": { "type": "string", "maxLength": 120 },
        "estimatedBudgetPkr": { "type": "number" },
        "elevationMeters": { "type": "number" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "highlights": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "region", "description", "imageUrl", "bestTimeToVisit", "estimatedBudgetPkr", "createdAt", "updatedAt"]
    },
    "GuideProfile": {
      "title": "GuideProfile",
      "description": "Public tour guide marketplace profile (strictly excludes CNIC and private address).",
      "type": "object",
      "properties": {
        "guideId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "avatarUrl": { "type": "string", "maxLength": 120000 },
        "bio": { "type": "string", "maxLength": 1500 },
        "experienceYears": { "type": "number" },
        "languages": { "type": "array" },
        "specializations": { "type": "array" },
        "availableDestinations": { "type": "array" },
        "startingPricePkr": { "type": "number" },
        "verificationStatus": { "type": "string", "enum": ["not_submitted", "pending", "under_review", "verified", "rejected", "resubmission_required"] },
        "ratingAvg": { "type": "number" },
        "reviewCount": { "type": "number" },
        "completedToursCount": { "type": "number" },
        "availabilityStatus": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["guideId", "ownerUid", "displayName", "bio", "experienceYears", "startingPricePkr", "verificationStatus", "createdAt", "updatedAt"]
    },
    "GuideVerification": {
      "title": "GuideVerification",
      "description": "Private CNIC and identity verification records restricted strictly to owner and admin.",
      "type": "object",
      "properties": {
        "guideId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "legalFullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "cnicNumber": { "type": "string", "minLength": 5, "maxLength": 25 },
        "contactNumber": { "type": "string", "minLength": 7, "maxLength": 30 },
        "address": { "type": "string", "minLength": 4, "maxLength": 300 },
        "cnicFrontReference": { "type": "string", "maxLength": 300 },
        "cnicBackReference": { "type": "string", "maxLength": 300 },
        "certificateTitle": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["not_submitted", "pending", "under_review", "verified", "rejected", "resubmission_required"] },
        "adminRemarks": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["guideId", "ownerUid", "legalFullName", "cnicNumber", "contactNumber", "address", "status", "createdAt", "updatedAt"]
    },
    "GuideVideo": {
      "title": "GuideVideo",
      "description": "Previous tour videos published by tour guides.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guideId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "description": { "type": "string", "maxLength": 800 },
        "destination": { "type": "string", "maxLength": 100 },
        "tourDate": { "type": "string", "maxLength": 40 },
        "videoUrl": { "type": "string", "maxLength": 500 },
        "thumbnailUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "guideId", "ownerUid", "title", "destination", "tourDate", "videoUrl", "createdAt"]
    },
    "GuidePackage": {
      "title": "GuidePackage",
      "description": "Tour packages published by verified tour guides.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guideId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guideName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "minLength": 3, "maxLength": 140 },
        "destination": { "type": "string", "minLength": 2, "maxLength": 120 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 2000 },
        "days": { "type": "number" },
        "nights": { "type": "number" },
        "pricePerPersonPkr": { "type": "number" },
        "groupPricePkr": { "type": "number" },
        "minTravelers": { "type": "number" },
        "maxTravelers": { "type": "number" },
        "includedServices": { "type": "array" },
        "excludedServices": { "type": "array" },
        "accommodationSummary": { "type": "string", "maxLength": 400 },
        "transportSummary": { "type": "string", "maxLength": 400 },
        "dailyItinerary": { "type": "array" },
        "availableDates": { "type": "string", "maxLength": 200 },
        "cancellationPolicy": { "type": "string", "maxLength": 500 },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "guideId", "ownerUid", "guideName", "title", "destination", "days", "nights", "pricePerPersonPkr", "isPublished", "createdAt", "updatedAt"]
    },
    "TravelPlan": {
      "title": "TravelPlan",
      "description": "Custom tourist travel plan created in the trip planner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "touristUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "touristName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "minLength": 3, "maxLength": 140 },
        "startingLocation": { "type": "string", "maxLength": 100 },
        "destinations": { "type": "array" },
        "departureDate": { "type": "string", "maxLength": 40 },
        "returnDate": { "type": "string", "maxLength": 40 },
        "travelersCount": { "type": "number" },
        "budgetPkr": { "type": "number" },
        "preferredTransport": { "type": "string", "maxLength": 120 },
        "hotelRequirement": { "type": "string", "maxLength": 120 },
        "activities": { "type": "array" },
        "specialInstructions": { "type": "string", "maxLength": 1000 },
        "estimatedCostPkr": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "sent", "quoted", "booked", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "touristUid", "touristName", "title", "startingLocation", "destinations", "departureDate", "returnDate", "travelersCount", "budgetPkr", "status", "createdAt", "updatedAt"]
    },
    "GuideRequest": {
      "title": "GuideRequest",
      "description": "Custom trip plan request sent by a tourist to a tour guide, including guide quotations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planId": { "type": "string", "maxLength": 128 },
        "touristUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "touristName": { "type": "string", "maxLength": 100 },
        "guideId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guideOwnerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guideName": { "type": "string", "maxLength": 100 },
        "tripTitle": { "type": "string", "minLength": 2, "maxLength": 140 },
        "startingLocation": { "type": "string", "maxLength": 100 },
        "destinations": { "type": "array" },
        "departureDate": { "type": "string", "maxLength": 40 },
        "returnDate": { "type": "string", "maxLength": 40 },
        "travelersCount": { "type": "number" },
        "budgetPkr": { "type": "number" },
        "preferredTransport": { "type": "string", "maxLength": 120 },
        "hotelRequirement": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "viewed", "quotation_sent", "accepted", "rejected", "cancelled", "booking_requested", "completed"] },
        "quotedPricePkr": { "type": "number" },
        "proposedItinerary": { "type": "string", "maxLength": 2000 },
        "guideMessage": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "touristUid", "touristName", "guideId", "guideOwnerUid", "guideName", "tripTitle", "destinations", "departureDate", "returnDate", "travelersCount", "budgetPkr", "status", "createdAt", "updatedAt"]
    },
    "Hotel": {
      "title": "Hotel",
      "description": "Registered hotel property and room inventory.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "destination": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 250 },
        "description": { "type": "string", "maxLength": 1500 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "facilities": { "type": "array" },
        "checkInTime": { "type": "string", "maxLength": 40 },
        "checkOutTime": { "type": "string", "maxLength": 40 },
        "cancellationPolicy": { "type": "string", "maxLength": 500 },
        "rooms": { "type": "array" },
        "startingPricePkr": { "type": "number" },
        "verificationStatus": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "ratingAvg": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "ownerName", "name", "destination", "address", "startingPricePkr", "verificationStatus", "createdAt", "updatedAt"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Registered vehicle for tourism rental with optional driver configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "brand": { "type": "string", "maxLength": 80 },
        "model": { "type": "string", "maxLength": 80 },
        "modelYear": { "type": "number" },
        "category": { "type": "string", "enum": ["4x4 Jeep", "SUV", "Car", "Hiace Van", "Coaster"] },
        "seats": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "fuelType": { "type": "string", "maxLength": 40 },
        "transmission": { "type": "string", "maxLength": 40 },
        "acAvailable": { "type": "boolean" },
        "condition": { "type": "string", "maxLength": 60 },
        "pickupLocation": { "type": "string", "maxLength": 120 },
        "serviceAreas": { "type": "array" },
        "pricePerDayPkr": { "type": "number" },
        "driverOption": { "type": "string", "enum": ["with_driver_only", "without_driver_only", "both"] },
        "driverFeePerDayPkr": { "type": "number" },
        "selfDriveEligibility": { "type": "string", "maxLength": 300 },
        "rentalTerms": { "type": "string", "maxLength": 600 },
        "verificationStatus": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "availableForBooking": { "type": "boolean" },
        "ratingAvg": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "ownerName", "name", "category", "seats", "pickupLocation", "pricePerDayPkr", "driverOption", "verificationStatus", "availableForBooking", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Booking request for a tour package, custom guide trip, hotel stay, or vehicle rental.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingType": { "type": "string", "enum": ["package", "guide_custom", "hotel", "vehicle"] },
        "touristUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "touristName": { "type": "string", "maxLength": 100 },
        "providerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "providerName": { "type": "string", "maxLength": 100 },
        "listingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "listingTitle": { "type": "string", "maxLength": 160 },
        "destination": { "type": "string", "maxLength": 120 },
        "startDate": { "type": "string", "maxLength": 40 },
        "endDate": { "type": "string", "maxLength": 40 },
        "daysCount": { "type": "number" },
        "guestsCount": { "type": "number" },
        "roomType": { "type": "string", "maxLength": 60 },
        "driverSelected": { "type": "boolean" },
        "pickupLocation": { "type": "string", "maxLength": 120 },
        "estimatedTotalPkr": { "type": "number" },
        "notes": { "type": "string", "maxLength": 800 },
        "bookingStatus": { "type": "string", "enum": ["pending", "accepted", "rejected", "confirmed", "active", "completed", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["not_required_yet", "coming_soon"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "bookingType", "touristUid", "touristName", "providerUid", "providerName", "listingId", "listingTitle", "startDate", "endDate", "daysCount", "estimatedTotalPkr", "bookingStatus", "paymentStatus", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Real-time conversation message between a tourist and a service provider.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "conversationKey": { "type": "string", "minLength": 3, "maxLength": 180 },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "maxLength": 100 },
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientName": { "type": "string", "maxLength": 100 },
        "relatedListingTitle": { "type": "string", "maxLength": 140 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "participants": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationKey", "senderUid", "senderName", "recipientUid", "recipientName", "text", "participants", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Booking, quotation, verification, and message alerts for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "body": { "type": "string", "minLength": 1, "maxLength": 500 },
        "type": { "type": "string", "enum": ["booking", "quotation", "verification", "message", "system"] },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientUid", "title", "body", "type", "isRead", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer rating and review tied to a completed booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetType": { "type": "string", "enum": ["guide", "hotel", "vehicle"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetName": { "type": "string", "maxLength": 140 },
        "providerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "providerReply": { "type": "string", "maxLength": 800 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetType", "targetId", "providerUid", "bookingId", "authorUid", "authorName", "rating", "comment", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user account profiles and saved preferences."
    },
    "/destinations/{destId}": {
      "schema": { "$ref": "#/entities/Destination" },
      "description": "Public Pakistan tourist destinations catalog."
    },
    "/guides/{guideId}": {
      "schema": { "$ref": "#/entities/GuideProfile" },
      "description": "Public tour guide marketplace profiles."
    },
    "/guideVerifications/{guideId}": {
      "schema": { "$ref": "#/entities/GuideVerification" },
      "description": "Private CNIC and verification documents for guides."
    },
    "/guideVideos/{videoId}": {
      "schema": { "$ref": "#/entities/GuideVideo" },
      "description": "Previous tour showcase videos uploaded by tour guides."
    },
    "/packages/{packageId}": {
      "schema": { "$ref": "#/entities/GuidePackage" },
      "description": "Tour packages published by verified tour guides."
    },
    "/travelPlans/{planId}": {
      "schema": { "$ref": "#/entities/TravelPlan" },
      "description": "Personal custom travel plans built by tourists."
    },
    "/guideRequests/{requestId}": {
      "schema": { "$ref": "#/entities/GuideRequest" },
      "description": "Custom trip plan requests and guide quotations."
    },
    "/hotels/{hotelId}": {
      "schema": { "$ref": "#/entities/Hotel" },
      "description": "Hotel properties and room inventories."
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Rental cars, 4x4 jeeps, SUVs, and vans with driver options."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Unified booking requests for guides, packages, hotels, and vehicles."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Conversations between tourists and service providers."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User alerts for bookings, quotations, verification, and messages."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Verified reviews linked to completed bookings."
    }
  }
}
